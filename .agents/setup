#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

install_node() {
  local node_version="22.23.2"
  local node_prefix="$HOME/.local/share/vibbit-node"
  local n_install="$HOME/.local/share/vibbit-n"
  local profile_marker="# vibbit Node.js toolchain"

  if [[ ! -x "$node_prefix/bin/node" ]] \
    || [[ "$($node_prefix/bin/node --version)" != "v$node_version" ]]; then
    command -v npm >/dev/null 2>&1 || {
      echo "npm is required to bootstrap the pinned Node.js toolchain." >&2
      return 1
    }
    npm install --global --prefix "$n_install" n@10.2.0
    N_PREFIX="$node_prefix" "$n_install/bin/n" "$node_version"
  fi

  export PATH="$node_prefix/bin:$PATH"
  hash -r

  if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# vibbit Node.js toolchain
case ":$PATH:" in
  *":$HOME/.local/share/vibbit-node/bin:"*) ;;
  *) export PATH="$HOME/.local/share/vibbit-node/bin:$PATH" ;;
esac
EOF
  fi

  printf 'Using Node.js %s and npm %s\n' "$(node --version)" "$(npm --version)"
}

install_system_packages() {
  local packages=(
    zip
    build-essential
    pkg-config
    libcairo2-dev
    libpango1.0-dev
    libjpeg-dev
    libgif-dev
    librsvg2-dev
    libasound2
    libatk-bridge2.0-0
    libatk1.0-0
    libatspi2.0-0
    libcairo2
    libcups2
    libdbus-1-3
    libdrm2
    libgbm1
    libglib2.0-0
    libnspr4
    libnss3
    libpango-1.0-0
    libx11-6
    libxcb1
    libxcomposite1
    libxdamage1
    libxext6
    libxfixes3
    libxkbcommon0
    libxrandr2
    xvfb
    fonts-noto-color-emoji
    fonts-unifont
    libfontconfig1
    libfreetype6
    xfonts-scalable
    fonts-liberation
    fonts-ipafont-gothic
    fonts-wqy-zenhei
    fonts-tlwg-loma-otf
    fonts-freefont-ttf
  )
  local missing=()
  local package status

  for package in "${packages[@]}"; do
    status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)"
    if [[ "$status" != "install ok installed" ]]; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} == 0)); then
    echo "All required system packages are already installed."
    return
  fi

  local apt=(apt-get)
  if ((EUID != 0)); then
    command -v sudo >/dev/null 2>&1 || {
      echo "sudo is required to install missing system packages: ${missing[*]}" >&2
      return 1
    }
    apt=(sudo apt-get)
  fi

  printf 'Installing missing system packages: %s\n' "${missing[*]}"
  "${apt[@]}" update
  "${apt[@]}" install -y --no-install-recommends "${missing[@]}"
}

install_dependencies() {
  npm ci
}

install_browser() {
  ./node_modules/.bin/playwright install chromium
}

run_step "Installing Node.js toolchain" install_node
run_step "Checking system packages" install_system_packages
run_step "Installing locked npm dependencies" install_dependencies
run_step "Installing Playwright Chromium" install_browser

echo "Orb setup complete."
