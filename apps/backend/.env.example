# Backend runtime
PORT=8787
VIBBIT_ALLOW_ORIGIN=*
VIBBIT_REQUEST_TIMEOUT_MS=60000
VIBBIT_EMPTY_RETRIES=2
VIBBIT_VALIDATION_RETRIES=2
# Optional path for persisted admin-configured provider settings.
VIBBIT_STATE_FILE=.vibbit-backend-state.json
# Optional fixed admin auth token for /admin endpoints.
# If empty, backend auto-generates and persists one in VIBBIT_STATE_FILE.
VIBBIT_ADMIN_TOKEN=
# Bookmarklet endpoints
VIBBIT_BOOKMARKLET_ENABLED=true
VIBBIT_BOOKMARKLET_ENABLE_BYOK=true
# Chrome extension download endpoint redirect target
VIBBIT_EXTENSION_DOWNLOAD_URL=https://github.com/tinkertanker/vibbit/releases/latest/download/vibbit-extension.zip

# Deployment posture
# hosted = multi-tenant classroom host (fail-closed). self-hosted = laptop/school server.
VIBBIT_DEPLOYMENT_MODE=self-hosted
# Required for hosted: pathless https origin used for OAuth/share links (ignores Host header).
VIBBIT_PUBLIC_ORIGIN=
# Trust X-Forwarded-* only behind a known reverse proxy.
VIBBIT_TRUST_PROXY=false
# Self-hosted only: keep legacy single class code + /admin provider panel (default true).
VIBBIT_LEGACY_CLASSROOM_CODES=true
VIBBIT_ADMIN_PANEL_ENABLED=true

# Teacher portal (multi-classroom)
# Teachers sign in at /teacher, save an OpenAI-compatible API key + base URL,
# then mint classroom codes for students (URL + code in the extension).
# Google OAuth (required for hosted deployments):
VIBBIT_GOOGLE_CLIENT_ID=
VIBBIT_GOOGLE_CLIENT_SECRET=
# Optional fixed redirect URI. Default: {public-origin}/teacher/auth/google/callback
VIBBIT_GOOGLE_REDIRECT_URI=
# Local/dev email login (default: false). Forbidden in hosted mode. Self-hosted opt-in only.
VIBBIT_TEACHER_DEV_LOGIN=false

# Credential encryption at rest (AES-256-GCM). Required for hosted mode.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIBBIT_CREDENTIAL_ENCRYPTION_KEY=

# Outbound endpoint policy (SSRF defence for classroom API base URLs)
# Extra allowed hostnames for custom OpenAI-compatible endpoints (comma list; *.example.com ok).
# Built-in allow-list already includes api.openai.com, openrouter.ai, Anthropic, Gemini.
VIBBIT_CUSTOM_ENDPOINT_ALLOWLIST=
# Self-hosted only: allow http:// and private/local resolved addresses (default false).
VIBBIT_ALLOW_PRIVATE_ENDPOINTS=false

# Rate limits / quotas (classroom spend containment)
VIBBIT_RATE_CONNECT_PER_IP_PER_MIN=10
VIBBIT_RATE_CONNECT_GLOBAL_PER_MIN=300
VIBBIT_RATE_GENERATE_PER_SESSION_PER_MIN=6
VIBBIT_RATE_GENERATE_PER_CLASSROOM_PER_MIN=90
VIBBIT_RATE_GENERATE_PER_CLASSROOM_PER_DAY=500
VIBBIT_RATE_CONCURRENT_PER_CLASSROOM=8
VIBBIT_RATE_CONCURRENT_GLOBAL=32

# Auth mode
# 1) Classroom mode (recommended for schools)
#    Leave SERVER_APP_TOKEN empty. Teachers mint codes at /teacher.
#    Optional legacy single class code below still works for simple setups.
VIBBIT_CLASSROOM_ENABLED=true
VIBBIT_CLASSROOM_CODE=
VIBBIT_CLASSROOM_CODE_AUTO=true
# Generated classroom codes are 5 uppercase letters.
VIBBIT_CLASSROOM_CODE_LENGTH=5
VIBBIT_CLASSROOM_SEED=
VIBBIT_SESSION_TTL_MS=28800000

# 2) Legacy app-token mode (optional)
#    If set, classroom mode is disabled and extension APP_TOKEN must match this value.
SERVER_APP_TOKEN=

# Provider and model routing
VIBBIT_ENABLED_PROVIDERS=openai,gemini,openrouter
VIBBIT_PROVIDER=openai
VIBBIT_MODEL=gpt-4o-mini

# Optional model allow-lists (comma-separated)
VIBBIT_OPENAI_ALLOWED_MODELS=
VIBBIT_GEMINI_ALLOWED_MODELS=
VIBBIT_OPENROUTER_ALLOWED_MODELS=

# Shared/default key fallback (optional if setting keys via /admin)
VIBBIT_API_KEY=

# Provider-specific overrides (optional if setting keys via /admin)
VIBBIT_OPENAI_API_KEY=
VIBBIT_OPENAI_MODEL=gpt-4o-mini

VIBBIT_GEMINI_API_KEY=
VIBBIT_GEMINI_MODEL=gemini-2.5-flash

VIBBIT_OPENROUTER_API_KEY=
VIBBIT_OPENROUTER_MODEL=openrouter/auto
